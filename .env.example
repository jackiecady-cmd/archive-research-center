# PostgreSQL connection used by the API and database scripts.
DATABASE_URL=postgresql://postgres:password@localhost:5432/archive_research_center

# Optional local service overrides.
API_PORT=8080
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:8080

# Comma-separated browser origins allowed to call the API with credentials.
# Do not use *. The web app and API should stay on the same site so the
# SameSite=Lax session cookie is sent.
CORS_ORIGINS=http://localhost:5173

# Email that receives the admin role when that address registers or signs in.
# Register the account yourself. This file must not contain a password.
ADMIN_EMAIL=

# Set to 1 only when a trusted reverse proxy sits in front of the API.
TRUST_PROXY=

# Optional database used by `pnpm test`. Defaults to a local test database.
# TEST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/archive_research_center_test
